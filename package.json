{
  "name": "OpenSketch",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @workspace/web dev",
    "build": "pnpm --filter @workspace/editor-core build && pnpm --filter @workspace/web build",
    "build:module": "pnpm --filter @workspace/editor-core build && pnpm --filter @workspace/web build:module",
    "build:module-release": "pnpm --filter @workspace/editor-core build && pnpm --filter @workspace/web build:release-pwa && pnpm --filter @workspace/web build:module && node scripts/release/assemble-module-release.mjs && node scripts/release/check-module-release.mjs",
    "build:pages": "VITE_PUBLIC_BASE=/OpenSketch/ pnpm build",
    "build:root": "VITE_PUBLIC_BASE=/ pnpm build",
    "preview": "pnpm --filter @workspace/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --project scripts/tsconfig.json",
    "test": "pnpm styles:check && vitest run",
    "styles:check": "node scripts/check-style-ownership.mjs && node scripts/check-primitive-usage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit --grep @smoke",
    "test:webmcp": "vitest run tests/semantic-runtime.test.ts tests/semantic-editor-adapter.test.ts tests/composition.test.ts tests/compound-analysis.test.ts tests/webmcp.test.ts tests/project-lifecycle.test.ts tests/webmcp-documentation.test.ts && pnpm build && node scripts/check-webmcp-build.mjs && pnpm test:webmcp:e2e",
    "test:deployment": "node scripts/check-deployment-build.mjs",
    "test:webmcp:e2e": "playwright test tests/e2e/webmcp.spec.ts --project=chromium",
    "test:webmcp:composition": "playwright test tests/e2e/webmcp-composition.spec.ts --project=chromium",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:sync": "tsx scripts/assets/sync-nih.ts",
    "assets:sync:open": "tsx scripts/assets/sync-open-assets.ts",
    "assets:sync:bioicons": "tsx scripts/assets/sync-bioicons.ts",
    "assets:taxonomy:open": "tsx scripts/assets/reclassify-open-assets.ts",
    "assets:sync:commons": "tsx scripts/assets/sync-commons.ts",
    "assets:validate": "tsx scripts/assets/validate-assets.ts",
    "assets:thumbnails": "tsx scripts/assets/generate-thumbnails.ts",
    "assets:manifest": "tsx scripts/assets/build-manifest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "dompurify": "^3.2.6",
    "fake-indexeddb": "^6.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "1.17.1",
    "piscina": "^5.1.3",
    "playwright": "1.62.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "svgo": "^4.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
