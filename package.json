{
  "name": "OpenSketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @workspace/web dev",
    "build": "pnpm --filter @workspace/editor-core build && pnpm --filter @workspace/web build",
    "preview": "pnpm --filter @workspace/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --project scripts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit --grep @smoke",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:sync": "tsx scripts/assets/sync-nih.ts",
    "assets:sync:open": "tsx scripts/assets/sync-open-assets.ts",
    "assets:sync:bioicons": "tsx scripts/assets/sync-bioicons.ts",
    "assets:taxonomy:open": "tsx scripts/assets/reclassify-open-assets.ts",
    "assets:sync:commons": "tsx scripts/assets/sync-commons.ts",
    "assets:validate": "tsx scripts/assets/validate-assets.ts",
    "assets:thumbnails": "tsx scripts/assets/generate-thumbnails.ts",
    "assets:manifest": "tsx scripts/assets/build-manifest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.2.6",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "1.17.1",
    "piscina": "^5.1.3",
    "playwright": "1.62.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "svgo": "^4.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
